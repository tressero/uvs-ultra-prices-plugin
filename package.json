{
  "name": "uvs-ultra-prices-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that shows TCGplayer prices on UVS Ultra decks",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "icons": "node tools/make-icons.mjs",
    "fixtures": "node tools/fetch-fixtures.mjs",
    "set-map": "node tools/build-set-map.mjs",
    "prices": "node tools/build-mock-prices.mjs",
    "serve": "node tools/serve-fixtures.mjs",
    "preview": "node tools/preview.mjs",
    "shots": "node tools/crop-preview.mjs",
    "coverage": "node tools/report-coverage.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.50.0",
    "vitest": "^3.0.0"
  }
}
