{
  "name": "uvs-ultra-prices-plugin",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Browser extension (Chrome and Firefox) that shows TCGplayer prices on UVS Ultra decks and cards, with deck totals and Mass Entry buy links",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "build:firefox": "node build.mjs --firefox",
    "build:firefox:dev": "node build.mjs --firefox --dev",
    "icons": "node tools/make-icons.mjs",
    "fixtures": "node tools/fetch-fixtures.mjs",
    "set-map": "node tools/build-set-map.mjs",
    "prices": "node tools/build-mock-prices.mjs",
    "serve": "node tools/serve-fixtures.mjs",
    "preview": "node tools/preview.mjs",
    "shots": "node tools/crop-preview.mjs",
    "coverage": "node tools/report-coverage.mjs",
    "popup": "node tools/inspect-popup.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --test-scheduled",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:tail": "wrangler tail --config worker/wrangler.jsonc",
    "worker:kv": "wrangler kv namespace create PRICING --config worker/wrangler.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:live": "node tools/check-live.mjs",
    "worker:prime": "node tools/prime-worker.mjs",
    "screenshots": "node tools/store-shots.mjs",
    "package": "node build.mjs && node tools/package.mjs",
    "package:firefox": "node build.mjs --firefox && node tools/package.mjs --firefox",
    "package:all": "npm run package && npm run package:firefox",
    "build-for-amo": "npm run build:firefox",
    "lint:firefox": "web-ext lint --source-dir dist-firefox --warnings-as-errors",
    "source:firefox": "node tools/source-zip.mjs",
    "sign:firefox": "node tools/sign-firefox.mjs",
    "release": "node tools/release.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.50.0",
    "vitest": "^3.0.0",
    "web-ext": "^10.8.0",
    "wrangler": "^4.86.0"
  }
}
