{
  "manifest_version": 3,
  "name": "UVS Ultra Deck Prices",
  "version": "0.1.0",
  "description": "Shows TCGplayer prices on UVS Ultra decks, deck lists and cards, with deck totals and a Mass Entry buy link.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://uvsultra.online/*"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://uvsultra.online/deck.php*"
      ],
      "js": ["deck.js", "cards.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://uvsultra.online/topdecks.php*",
        "https://uvsultra.online/folder.php*",
        "https://uvsultra.online/user.php*"
      ],
      "js": ["list.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://uvsultra.online/index.php*",
        "https://uvsultra.online/showcard.php*"
      ],
      "js": ["cards.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "UVS Ultra Deck Prices"
  }
}
