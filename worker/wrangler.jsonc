{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "uvs-ultra-prices",
  "main": "src/index.js",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },

  // Created with `npm run worker:kv` (2026-10-31).
  "kv_namespaces": [
    {
      "binding": "PRICING",
      "id": "54c9c2137b9a4cdabd2ac16c05f29b88"
    }
  ],

  // tcgcsv rebuilds once a day. One run can refresh ~20 sets (free plan: 50
  // subrequests per invocation), so three runs cover the whole catalog.
  "triggers": {
    "crons": ["17 4 * * *", "47 4 * * *", "17 5 * * *"]
  },

  "vars": {
    "SOURCE_BASE": "https://tcgcsv.com",
    "CATALOG_CATEGORY": "25",
    "USER_AGENT": "UVSUltraPrices/0.1.0 (Chrome extension)"
  }
}
