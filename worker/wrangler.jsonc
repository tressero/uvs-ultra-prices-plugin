{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "uvs-ultra-prices",
  "main": "src/index.js",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },

  // Created with `npm run worker:kv` (2026-10-31).
  "kv_namespaces": [
    {
      "binding": "PRICING",
      "id": "54c9c2137b9a4cdabd2ac16c05f29b88"
    }
  ],

  // Prices refresh twice a day at 2am and 2pm America/New_York. Cron is UTC
  // only, so both DST offsets are listed; the scheduled handler runs only when
  // the Eastern hour is 2 or 14 (the other two invocations are no-ops).
  // A run refreshes at most 24 sets (free plan: 50 subrequests per invocation),
  // so the 2am run takes the first 24 and the 2pm run finishes the catalog.
  "triggers": {
    "crons": ["0 6,18 * * *", "0 7,19 * * *"]
  },

  "vars": {
    "SOURCE_BASE": "https://tcgcsv.com",
    "CATALOG_CATEGORY": "25",
    "USER_AGENT": "UVSUltraPrices/0.1.0 (browser extension)",
    // Public by design: rendered as a meta tag on the landing page for
    // Search Console's HTML-tag verification method.
    "SITE_VERIFICATION": "RSaimRNQeBQ9mML2wXFmU3awMDiCrbLlS_tKmDEPd0s"
  }
}
